// Static-assets Worker for the Strata Studio site (assets-only: no Worker
// script, so requests stay free and UNLIMITED on every Cloudflare plan).
// Deliberately separate from workers/proxy — enabling Workers Cache there
// meters its requests, and we never want the app shell metered.
//
// Deploy:  bun run --cwd web build && bunx wrangler deploy --cwd web
// First time: bunx wrangler login
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "strata-studio",
  "compatibility_date": "2026-07-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
