{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ../scripts/bun-check.mjs && vite build && bun run assert:proxy-first",
    "assert:proxy-first": "bun run scripts/assert-proxy-first.ts",
    "lint": "oxlint",
    "typecheck": "node ../scripts/bun-check.mjs",
    "test": "bun test",
    "format": "prettier --write .",
    "preview": "vite preview",
    "typecheck:tsc": "tsc -b",
    "audit": "bun audit && bun audit --production"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@mapbox/vector-tile": "2.0.5",
    "geotiff": "3.0.5",
    "gifenc": "^1.0.3",
    "maplibre-gl": "6.4.1",
    "pbf": "4.0.2",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "simplex-noise": "^4.0.3",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bun-types": "^1.4.4",
    "fast-check": "4.10.2",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.2.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "8.3.5"
  },
  "patchedDependencies": {
    "upng-js@2.1.0": "patches/upng-js@2.1.0.patch"
  }
}
